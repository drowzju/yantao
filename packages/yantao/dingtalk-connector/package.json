{
  "name": "@deepseek-ai/dsh-yantao-dingtalk",
  "description": "DingTalk IM channel plugin for the yantao workbench: Stream long-connection inbound, AI-card/markdown/text outbound, slash commands and approval cards, with the corporate-network proxy adaptations folded in",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/yantao/dingtalk-connector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "assets/**"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "cross-spawn": "7.0.6",
    "dingtalk-stream": "^2.1.4",
    "https-proxy-agent": "^9.1.0",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@types/cross-spawn": "^6.0.6",
    "@types/qrcode-terminal": "^0.12.2"
  }
}
