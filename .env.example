# yantao 模型网关密钥。复制后填入真实值即可（`.env` 已被 .gitignore 忽略，本模板才入库）：
#   cp .env.example .env
#
# 这里只放密钥。网关地址与模型 id 属于「实例」配置，不走环境——换模型请看下方的
# 「换模型」小节。术语见 CONTEXT.md: LLM 网关 / Model Gateway。

MODEL_GATEWAY_API_KEY=

# ---- 换模型 ----
# 不要改仓库里的 packages/bundle/yantao/cordis.patch.yml：那是开箱默认值，是入库的。
# 改你自己的 profile patch 层 ~/.dsh/profiles/yantao/cordis.patch.yml，整行覆盖即可：
#
# - id: llm-pi-ai
#   config:
#     providers:
#       model-gateway:
#         displayName: 内网模型网关
#         apiKeyEnv: MODEL_GATEWAY_API_KEY
#         api: openai-completions
#         baseURL: https://<你的网关>/v1        # 填到 /v1，不要带 /chat/completions
#         compat:
#           thinkingFormat: deepseek
#         models:
#           - id: <网关认的模型 id>
#             name: <显示名>
#             contextWindow: 131072
#             maxTokens: 32768
#
# - id: agent-default-model
#   config:
#     provider: model-gateway
#     model: <上面那个 id>
#
# 另一条路：启动后在「设置 → 模型」里添加提供方与模型——存在 $DSH_HOME/.credentials.yaml，
# 仅本用户可读，且优先级高于这里的一切。
#
# 踩坑记录：曾尝试用 `!!js process.env.X ?? 默认值` 让这些字段也走 .env，实测该变量未设置时
# dsh 并未回退到字面默认值（请求打到了别的端点，表现为 404），故放弃，只保留密钥走环境。

# ---- 本文件放哪 ----
#   1. <启动时的 cwd>/.env   —— 从本仓库目录启动时，就是本文件复制出的 .env
#   2. $DSH_HOME/.env        —— 默认 C:\Users\<你>\.dsh\.env，与启动目录无关
#
# 解析优先级（高 → 低）：启动环境（export / 命令行前缀）> $DSH_HOME/.credentials.yaml
#   > cwd 的 .env > $DSH_HOME 的 .env
# 注意：启动环境是进程启动时拍下的快照，改完 .env 要重启进程才生效。
